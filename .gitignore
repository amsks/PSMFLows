__pycache__/
dist/
*.py[cod]
*$py.class
*.egg-info/
.DS_Store
.idea/
.ruff_cache/

# Virtual environments
# `.venv` is a SYMLINK to /data-local here, and a trailing-slash pattern never matches a
# symlink -- hence the bare entry as well, or `git status` lists the whole venv.
.venv
.venv/
.venv*/
venv/

# Run artifacts
exp/
outputs/
multirun/
wandb/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
*.bbl
*.blg

# Diagnostic figures the tools drop in the repo root (viz_*, calibration_check,
# latent_reachability, ...). Curated figures live in assets/ and PAPER/ and stay tracked.
/*.png
.mypy_cache/*

# HPO run artifacts. The harness is tracked (tools/hpo_preimage_inversion.py,
# configs/hpo_preimage.yaml); its output is not — SMAC's state dir and the per-trial
# JSON belong in the sweep directory under $PSM_DATA/hpo, not in the repo.
smac3_output/
hpo_trial.json
